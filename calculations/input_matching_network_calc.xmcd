														<ml:apply>
															<ml:div/>
															<ml:real>0.332</ml:real>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">εeffC</ml:id>
																<ml:real>1.73</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:apply>
