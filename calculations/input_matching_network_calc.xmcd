									<ml:id xml:space="preserve">atan</ml:id>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve">ε</ml:id>
										<ml:apply>
											<ml:sqrt/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">εeffC</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">ε</ml:id>
													<ml:id xml:space="preserve">εeffC</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:apply>
