												<ml:id xml:space="preserve">exp</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:real>-0.45</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve">f</ml:id>
														<ml:id xml:space="preserve">FLpis</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:parens>
							</ml:apply>
						</ml:apply>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<ml:real>0.93016800432460622</ml:real>
						</result>
