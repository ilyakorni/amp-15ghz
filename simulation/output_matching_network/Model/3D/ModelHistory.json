        {
            "caption": "define time domain solver parameters",
            "version": "2025.1|34.0.1|20241028",
            "hidden": false,
            "type": "vba",
            "code": [
                "Mesh.SetCreator \"High Frequency\" ",
                "",
                "With Solver ",
                "     .Method \"Hexahedral\"",
                "     .CalculationType \"TD-S\"",
                "     .StimulationPort \"All\"",
                "     .StimulationMode \"All\"",
                "     .SteadyStateLimit \"-20\"",
                "     .MeshAdaption \"False\"",
